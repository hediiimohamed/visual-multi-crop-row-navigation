Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Frames:
        All Enabled: false
        base_link:
          Value: true
        visual_nav_camera_optical_frame:
          Value: true
    # 1) raw camera image
    - Class: rviz_default_plugins/Image
      Name: 1 Camera (raw)
      Enabled: true
      Topic:
        Value: /visual_nav_camera/rgb/image_raw
        Reliability Policy: Best Effort
    # 2) ExG: excess green index 2G-R-B, bright = vegetation
    - Class: rviz_default_plugins/Image
      Name: 2 ExG (green index)
      Enabled: true
      Topic:
        Value: /vs_nav/ExG
    # 3) binary plant mask (Otsu threshold on ExG)
    - Class: rviz_default_plugins/Image
      Name: 3 Mask (plants)
      Enabled: true
      Topic:
        Value: /vs_nav/mask
    # 4) detection: plant centres, tracking boxes, fitted rows, steering line
    - Class: rviz_default_plugins/Image
      Name: 4 Graphic (detection)
      Enabled: true
      Topic:
        Value: /vs_nav/graphic
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 3
        Y: -2.3
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1600
  Height: 950
